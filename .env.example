# Server only. Copy the Session pooler connection from Supabase Connect (port 5432).
# Use the migration/table-owner role for this initial release; never expose these URLs in clients.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?schema=app&sslmode=require&connection_limit=5
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?schema=app&sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
CORS_ORIGINS=http://localhost:5173
PORT=3001
